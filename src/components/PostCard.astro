---
import {Image} from "astro:assets";
import ClockIcon from "@/icons/time-line.svg";

interface Props {
    id: string;
    title: string;
    description: string;
    publishDate: Date;
    tags: string[];
    cover: {
        src: ImageMetadata;
        alt?: string;
    };
}

const {id, title, description, publishDate, tags, cover} = Astro.props as Props;

const maxVisibleTags = 2;
const visibleTags = tags.slice(0, maxVisibleTags);
const remainingTags = tags.length - maxVisibleTags;

const post = {
    id,
    data: {
        title,
        description,
        publishDate,
        tags,
        cover,
    },
};
---

<a href={`/blog/${id}`} aria-label={`Leer la publicacion sobre ${title}`} class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
    <div class="flex-none w-full md:w-56 h-40 md:h-36 overflow-hidden rounded-xl">
        <Image transition:name={`${post.id}-image`} src={post.data.cover.src} alt={post.data.cover.alt ?? title}
               class="w-full h-full object-cover rounded-xl"/>
    </div>
    <div class="flex flex-col gap-2 flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <div class="flex items-center gap-1">
                <ClockIcon class="w-4 h-4 text-gray-400 dark:text-gray-500"/>
                <time class="text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400" datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
            </div>
            {visibleTags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                    {visibleTags.map((tag) => (
                            <span class="text-xs sm:text-sm text-gray-400 dark:text-gray-500">#{tag}</span>
                    ))}
                    {remainingTags > 0 && (
                        <span class="text-xs sm:text-sm text-gray-400 dark:text-gray-500">+{remainingTags}</span>
                    )}
                </div>
            )}
        </div>
        <h3 class="text-lg sm:text-xl font-bold leading-tight">{post.data.title}</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{post.data.description}</p>
    </div>
</a>